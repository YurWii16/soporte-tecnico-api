            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte",
                "1"
              ]
            },
            "description": "Busca una solicitud específica por su ID. Retorna 200 OK."
          },
          "response": []
        },
        {
          "name": "4. Actualización completa (PUT)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Falla de conexión en el visor de Rayos X (Actualizado)\",\n  \"descripcion\": \"Se reinstalaron los drivers de red pero sigue con intermitencia extrema.\",\n  \"clinica\": \"Veterinaria San José - Surco\",\n  \"solicitante\": \"Dra. Marcela Mendoza\",\n  \"prioridad\": \"CRITICA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
