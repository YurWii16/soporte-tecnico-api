              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte",
                "1"
              ]
            },
            "description": "Actualiza todos los campos de una solicitud existente. Retorna 200 OK."
          },
          "response": []
