            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
