{
  "info": {
    "_postman_id": "84d5df68-963d-4c3e-8ea7-59fdb23e98cc",
    "name": "Soporte Técnico TI API",
    "description": "Colección de peticiones para los microservicios usuarios-api (puerto 8083) y soporte-tecnico-api (puerto 8080 con context path /api).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login Administrador (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.globals.set(\"jwt_token\", jsonData.token);",
                  "    console.log(\"Token JWT guardado automáticamente en la variable global 'jwt_token'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/api/v1/auth/login?username=admin&password=1234",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "1234"
                }
              ]
            },
            "description": "Inicia sesión como administrador. Al ejecutarse con éxito, guarda el token JWT automáticamente para las siguientes peticiones."
          },
          "response": []
        },
        {
          "name": "Login Técnico (TECNICO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.globals.set(\"jwt_token\", jsonData.token);",
                  "    console.log(\"Token JWT guardado automáticamente en la variable global 'jwt_token'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/api/v1/auth/login?username=tecnico&password=1234",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "tecnico"
                },
                {
                  "key": "password",
                  "value": "1234"
                }
              ]
            },
            "description": "Inicia sesión como técnico de turno. Guarda el token en la variable global 'jwt_token'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Solicitudes de Soporte",
      "item": [
        {
          "name": "1. Registro de solicitud (POST)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Falla de conexión en la VPN corporativa\",\n  \"descripcion\": \"No permite conectar al servidor remoto de bases de datos. Muestra error de autenticación 800.\",\n  \"clinica\": \"Sede Principal - Piso 3\",\n  \"solicitante\": \"carlos_soto\",\n  \"prioridad\": \"ALTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte"
              ]
            },
            "description": "Crea un nuevo ticket de soporte. Retorna un código 201 Created."
          },
          "response": []
        },
        {
          "name": "2. Listado general (GET)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte?page=0&size=10",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Recupera una lista paginada de las solicitudes creadas en el sistema. Retorna 200 OK."
          },
          "response": []
        },
        {
          "name": "3. Consulta por ID (GET)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte",
                "1"
              ]
            },
            "description": "Busca una solicitud específica por su ID. Retorna 200 OK."
          },
          "response": []
        },
        {
          "name": "4. Actualización completa (PUT)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Falla de conexión en la VPN corporativa (Actualizado)\",\n  \"descripcion\": \"Se reinstaló el cliente AnyConnect pero sigue saliendo error de credenciales.\",\n  \"clinica\": \"Sede Principal - Piso 3\",\n  \"solicitante\": \"carlos_soto\",\n  \"prioridad\": \"ALTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte",
                "1"
              ]
            },
            "description": "Actualiza todos los campos de una solicitud existente. Retorna 200 OK."
          },
          "response": []
        },
        {
          "name": "5. Cambio de estado (PATCH)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte/1/estado?estado=EN_PROCESO",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte",
                "1",
                "estado"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "EN_PROCESO"
                }
              ]
            },
            "description": "Actualiza de manera parcial el estado de la solicitud. Retorna 200 OK."
          },
          "response": []
        },
        {
          "name": "6. Eliminación (DELETE)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte",
                "1"
              ]
            },
            "description": "Elimina una solicitud del sistema. Retorna 204 No Content."
          },
          "response": []
        },
        {
          "name": "7. Validación incorrecta (POST)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"\",\n  \"descripcion\": \"Intento de envío de solicitud con título y sede en blanco.\",\n  \"clinica\": \"\",\n  \"solicitante\": \"carlos_soto\",\n  \"prioridad\": \"BAJA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/solicitudes-soporte",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "solicitudes-soporte"
              ]
            },
            "description": "Intenta crear un registro con campos obligatorios vacíos (como título y sede) para forzar un error 400 Bad Request."
          },
          "response": []
        }
      ]
    },
    {
